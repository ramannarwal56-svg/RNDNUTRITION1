# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_PATH or Connection string for persistence
DATABASE_PATH="./data/rnd_store.json"

# OTP Authentication Provider (options: mock, twilio, fast2sms, msg91)
OTP_PROVIDER="mock"
OTP_API_KEY=""

# SMTP Email Credentials (for actual Email OTPs)
SMTP_EMAIL="rndnutrition285@gmail.com"
SMTP_PASSWORD=""

# Indian Payment Gateway Configuration (options: mock, razorpay, cashfree)
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# UPI QR Payment Settings
QR_PAYMENT_UPI_ID="9306667128@upi"
QR_PAYMENT_PAYEE_NAME="RND Sports Nutrition"

# Shipping & Logistics Provider (options: mock, shiprocket, delhivery)
SHIPPING_PROVIDER="mock"
SHIPPING_API_KEY=""

# Email Provider Configuration (options: mock, resend, sendgrid, smtp)
EMAIL_PROVIDER="mock"
EMAIL_API_KEY=""
SUPPORT_EMAIL="ramannarwal56@gmail.com"

# Admin Configuration
ADMIN_PHONE="9306667128"
ADMIN_SECRET_KEY="rnd_admin_secure_passcode"

